<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.academy.user.order.OrderMapper">

  <resultMap id="OrderItemResult" type="com.academy.user.order.Order$OrderItem">
    <constructor>
      <idArg column="order_item_id" javaType="String"/>
      <arg   column="order_id"      javaType="String"/>
      <arg   column="mst_code"      javaType="String"/>
      <arg   column="quantity"      javaType="int"/>
      <arg   column="unit_price"    javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>

  <resultMap id="OrderResult" type="com.academy.user.order.Order">
    <constructor>
      <idArg column="order_id"         javaType="String"/>
      <arg   column="user_id"          javaType="String"/>
      <arg   column="status"           javaType="String"/>
      <arg   column="total_amount"     javaType="java.math.BigDecimal"/>
      <arg   column="discount_amount"  javaType="java.math.BigDecimal"/>
      <arg   column="mileage_used"     javaType="java.math.BigDecimal"/>
      <arg   column="created_at"       javaType="java.time.LocalDateTime"/>
      <arg   column="paid_at"          javaType="java.time.LocalDateTime"/>
      <arg   column="canceled_at"      javaType="java.time.LocalDateTime"/>
      <arg   javaType="java.util.List"
             select="findItemsByOrderId" column="order_id"/>
    </constructor>
  </resultMap>

  <insert id="insertOrder">
    INSERT INTO od_order (order_id, user_id, status, total_amount)
    VALUES (#{orderId}, #{userId}, 'PENDING', #{totalAmount})
  </insert>

  <insert id="insertItem">
    INSERT INTO od_order_item (order_item_id, order_id, mst_code, quantity, unit_price)
    VALUES (#{orderItemId}, #{orderId}, #{mstCode}, #{quantity}, #{unitPrice})
  </insert>

  <update id="markPaid">
    UPDATE od_order SET status='PAID', paid_at=#{paidAt} WHERE order_id=#{orderId}
  </update>

  <update id="markCanceled">
    UPDATE od_order SET status='CANCELED', canceled_at=#{canceledAt} WHERE order_id=#{orderId}
  </update>

  <select id="findById" resultMap="OrderResult">
    SELECT * FROM od_order WHERE order_id = #{orderId} LIMIT 1
  </select>

  <select id="findItemsByOrderId" resultMap="OrderItemResult">
    SELECT * FROM od_order_item WHERE order_id = #{orderId} ORDER BY order_item_id
  </select>

  <select id="findByUserId" resultMap="OrderResult">
    SELECT * FROM od_order WHERE user_id = #{userId} ORDER BY created_at DESC
  </select>

</mapper>
