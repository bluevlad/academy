# academy-integrated — 환경변수 예시
# 복사: cp .env.example .env  (.env 는 git ignore)

# ===== Spring =====
SPRING_PROFILES_ACTIVE=dev

# ===== DB (MariaDB 공용) =====
DB_URL=jdbc:mariadb://mariadb:3306/acm_basic?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_DRIVER=org.mariadb.jdbc.Driver

# ===== Redis =====
REDIS_HOST=academy-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Auth =====
# 최소 32 바이트 권장
JWT_SECRET=CHANGE_ME_MINIMUM_32_BYTES_FOR_HMAC_SHA256
# ADR-002 — ISO-8601 Duration. access 30분, refresh 14일
JWT_ACCESS_TTL=PT30M
JWT_REFRESH_TTL=P14D
GOOGLE_CLIENT_ID=
SUPER_ADMIN_EMAILS=rainend00@gmail.com

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:4001,http://localhost:3003

# ===== Ports =====
BACKEND_PORT=9000
ADMIN_WEB_PORT=4001
USER_WEB_PORT=3003

# ===== FE =====
VITE_API_BASE_URL=http://localhost:9000/api

# ===== Misc =====
TZ=Asia/Seoul
