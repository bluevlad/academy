# academy — 환경변수 예시 (로컬 개발용)
# 복사: cp .env.example .env  (.env 는 git ignore)
#
# 네이밍 규칙 (Ai-Legacy-bluevlad ENVIRONMENT_STANDARD §8.2):
#   - 서비스 전용: ACADEMY_*
#   - 공통: GOOGLE_*, SUPER_ADMIN_EMAILS, TZ
#
# 운영 배포 시 실제 값은 호스트 SSoT 파일(§8.3)에 보관됩니다:
#   /Users/rainend/GIT/Ai-Legacy-bluevlad/infrastructure/docker/.env.production

# ===== Spring =====
ACADEMY_SPRING_PROFILES_ACTIVE=dev

# ===== DB (호스트 MariaDB, §3.2) =====
ACADEMY_DB_URL=jdbc:mariadb://host.docker.internal:3306/acm_basic?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&useSSL=false
ACADEMY_DB_USERNAME=root
ACADEMY_DB_PASSWORD=CHANGE_ME
ACADEMY_DB_DRIVER=org.mariadb.jdbc.Driver

# ===== Redis =====
ACADEMY_REDIS_HOST=academy-redis
ACADEMY_REDIS_PORT=6379
ACADEMY_REDIS_PASSWORD=

# ===== Auth =====
# 최소 32 바이트 권장 (HMAC-SHA256)
ACADEMY_JWT_SECRET=CHANGE_ME_MINIMUM_32_BYTES_FOR_HMAC_SHA256
# ADR-002 — ISO-8601 Duration
ACADEMY_JWT_ACCESS_TTL=PT30M
ACADEMY_JWT_REFRESH_TTL=P14D

# ===== CORS =====
ACADEMY_CORS_ORIGINS=https://academy.unmong.com,http://localhost:4001,http://localhost:4002

# ===== Ports (§5.2) =====
ACADEMY_BACKEND_PORT=9001
ACADEMY_ADMIN_WEB_PORT=4001
ACADEMY_USER_WEB_PORT=4002

# ===== FE 빌드타임 =====
ACADEMY_VITE_ADMIN_API_BASE_URL=/api
ACADEMY_VITE_USER_API_BASE_URL=/api

# ===== 공통 (§8.5 공통 키 레지스트리) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPER_ADMIN_EMAILS=rainend00@gmail.com
TZ=Asia/Seoul
